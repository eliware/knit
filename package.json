{
  "name": "@eliware/knit",
  "version": "13.0.0",
  "type": "module",
  "description": "GitHub webhook handler and SSH deployment automation tool with Discord notifications, message status, and metadata-aware validation workflows.",
  "keywords": [
    "knit",
    "nodejs",
    "webhook",
    "github",
    "deployment",
    "automation",
    "ssh",
    "kubernetes",
    "argo-cd",
    "validation",
    "discord",
    "ci",
    "cd",
    "github-webhooks",
    "webhook-handler",
    "self-hosted"
  ],
  "private": true,
  "main": "bin/knit.mjs",
  "bin": {
    "knit": "./bin/knit.mjs"
  },
  "files": [
    "src/",
    "assets/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/knit.mjs",
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "pack": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^12.0.1",
    "@eliware/discord": "^12.0.0",
    "@eliware/ssh-client": "^12.0.0",
    "body-parser": "^2.3.0",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "inquirer": "^14.2.1",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@eliware/test": "^12.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/knit.git"
  },
  "homepage": "https://github.com/eliware/knit#readme",
  "bugs": {
    "url": "https://github.com/eliware/knit/issues"
  },
  "eliware": {
    "id": "E-1310",
    "apply": [
      "general",
      "application",
      "discord",
      "ghcr-published"
    ]
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
